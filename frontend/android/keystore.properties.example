# Copy to keystore.properties (never committed) or point KOREX_KEYSTORE_PROPERTIES at your copy,
# then: ./gradlew bundleRelease -PplayUpload
# The real file and the .jks live outside the repo and are backed up in 1Password.
storeFile=C:/path/outside/the/repo/korex-upload.jks
storePassword=CHANGE_ME
keyAlias=korex-upload
keyPassword=CHANGE_ME
