{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": { "python": "3.13" },
  "steps": {
    "install": {
      "commands": [
        { "src": "backend/requirements.txt", "dest": "backend/requirements.txt" },
        "python -m venv /app/.venv",
        { "path": "/app/.venv/bin" },
        "/app/.venv/bin/pip install --no-cache-dir -r backend/requirements.txt"
      ]
    }
  },
  "deploy": {
    "paths": ["/app/.venv/bin"],
    "variables": { "VIRTUAL_ENV": "/app/.venv", "PYTHONUNBUFFERED": "1" },
    "startCommand": "cd backend && alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port $PORT"
  }
}
